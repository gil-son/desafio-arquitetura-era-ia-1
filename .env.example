# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# A partir da v2, estas chaves vivem SÓ no gateway; o serviço app não as recebe.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# --- AI Gateway (LiteLLM) ---
# Master key do gateway: usada só pelo bootstrap para criar as virtual keys.
LITELLM_MASTER_KEY=sk-litellm-master-0001
# URL de conexão do banco do gateway (Postgres do serviço db).
DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm

# Virtual keys criadas pelo bootstrap (valores fixos, sem passo manual):
# - a chave que a aplicação usa (com orçamento alto);
# - uma chave com orçamento baixo, para o roteiro de governança (budget);
# - uma chave com limite de requisições, para o roteiro de governança (rpm).
HELPDESK_GATEWAY_KEY=sk-helpdesk-app-0001
GATEWAY_BUDGET_KEY=sk-helpdesk-budget-0001
GATEWAY_RATELIMIT_KEY=sk-helpdesk-rpm-0001

# Como a aplicação alcança o gateway (base URL compatível com OpenAI).
GATEWAY_BASE_URL=http://gateway:4000
